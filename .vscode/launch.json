{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "启动校园二手交易与失物招领系统",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000",
        "HOST": "127.0.0.1"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}